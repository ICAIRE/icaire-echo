{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ICAIRE Echo",
  "version": "1.0.0",
  "identifier": "org.icaire.echo",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ICAIRE Echo",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0b1e27",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["stage/**/*"],
    "category": "Productivity",
    "shortDescription": "Record meetings with names, and make voice-overs, on your own computer",
    "copyright": "ICAIRE, MIT License",
    "macOS": {
      "minimumSystemVersion": "13.5",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
