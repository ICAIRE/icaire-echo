{
  "name": "meet-recorder-bot",
  "version": "1.0.0",
  "description": "Local team app: a Google Meet recorder with named transcripts, and AI voice-over with Kokoro.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "record": "node bot.js",
    "login": "node login.js",
    "merge": "node merge.js",
    "demo": "node test/ui-demo-server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/unit.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "test:ui": "node --test test/ui.test.js",
    "test:whisper": "node --test test/whisper.test.js",
    "test:voice": "node --test test/voice.test.js",
    "setup": "node setup.js"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@yomiscript/ja-accent": "^0.1.7",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.31.1",
    "playwright-core": "^1.65.1"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
