{
  "name": "icaire-echo",
  "version": "1.0.0",
  "description": "ICAIRE Echo: record meetings and get transcripts with names, and make voice-overs, all on your own computer.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "record": "node bot.js",
    "merge": "node merge.js",
    "demo": "node test/ui-demo-server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/unit.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "test:ui": "node --test test/ui.test.js",
    "test:whisper": "node --test test/whisper.test.js",
    "test:voice": "node --test test/voice.test.js",
    "setup": "node setup.js",
    "build:mac": "bash packaging/mac/build.sh",
    "build:windows": "powershell -ExecutionPolicy Bypass -File packaging/windows/build.ps1"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@yomiscript/ja-accent": "^0.1.7",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.31.1",
    "playwright-core": "^1.65.1",
    "sherpa-onnx-node": "^2.0.1"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ICAIRE/icaire-echo.git"
  }
}
